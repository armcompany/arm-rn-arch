{
  "name": "@armcompany/rn-arch",
  "version": "0.1.0",
  "description": "An autonomous architecture harness and CLI for production React Native projects.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/armcompany/armrnarch.git"
  },
  "homepage": "https://github.com/armcompany/armrnarch#readme",
  "bugs": {
    "url": "https://github.com/armcompany/armrnarch/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "rn-arch": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "schema",
    "skills"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && node --test 'dist/**/*.test.js'",
    "verify": "npm test",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
